{
  "name": "create-respondeo-app",
  "version": "0.1.0",
  "description": "Create a new Respondeo quiz application",
  "keywords": [
    "cli",
    "pnpm",
    "quiz",
    "respondeo",
    "scaffolding"
  ],
  "homepage": "https://docs.respondeo.app",
  "license": "MIT",
  "author": "Sebastian Danielsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebdanielsson/respondeo.git",
    "directory": "packages/create-respondeo-app"
  },
  "bin": {
    "create-respondeo-app": "dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "build:only": "pnpm run build",
    "dev": "tsx src/index.ts",
    "tsc": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "giget": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "oxlint": "^1.74.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
