{
  "name": "respondeo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:only": "turbo run build:only",
    "start": "turbo run start",
    "tsc": "turbo run tsc",
    "lint": "turbo run lint",
    "format": "bun --bun run oxfmt",
    "format:check": "bun --bun run oxfmt --check",
    "stylelint": "turbo run stylelint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=web",
    "db:push": "turbo run db:push --filter=web",
    "db:migrate": "turbo run db:migrate --filter=web",
    "db:studio": "turbo run db:studio --filter=web"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "oxfmt": "^0.42.0",
    "turbo": "^2.8.21",
    "typescript": "~6.0.2"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11"
}
