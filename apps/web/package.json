{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun next dev --turbopack",
    "build": "bun run --bun --no-env-file db:migrate && bun run --bun --no-env-file next build",
    "build:only": "bun run --bun --no-env-file next build",
    "start": "bun run --bun next start",
    "tsc": "tsc --noEmit",
    "lint": "bun run --bun --no-env-file oxlint && bun run --bun --no-env-file eslint",
    "format": "bun run oxfmt",
    "format:check": "bun run oxfmt --check",
    "stylelint": "stylelint --allow-empty-input \"./**/*.css\"",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:push": "bun run --bun drizzle-kit push",
    "db:migrate": "bun run --bun ./lib/db/migrate.ts",
    "db:studio": "bun run --bun drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/google": "^3.0.57",
    "@ai-sdk/openai": "^3.0.50",
    "@base-ui/react": "^1.3.0",
    "@better-auth/api-key": "~1.5.6",
    "@better-auth/drizzle-adapter": "~1.6.0",
    "@scalar/nextjs-api-reference": "^0.10.10",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.145",
    "better-auth": "~1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@tailwindcss/webpack": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.4",
    "eslint-config-turbo": "^2.8.21",
    "eslint-plugin-oxlint": "^1.58.0",
    "oxlint": "^1.58.0",
    "stylelint": "^17.6.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
