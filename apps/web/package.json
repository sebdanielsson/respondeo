{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "tsx ./lib/db/migrate.ts && next build",
    "build:only": "next build",
    "start": "next start",
    "tsc": "tsc --noEmit",
    "lint": "oxlint && eslint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "stylelint": "stylelint --allow-empty-input \"./**/*.css\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx ./lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests",
    "test:integration": "bash ./scripts/test-integration.sh",
    "loadtest": "k6 run ./tests/loadtest.js",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "~1.7.0",
    "@better-auth/drizzle-adapter": "~1.7.0",
    "@scalar/nextjs-api-reference": "^0.11.11",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.31",
    "better-auth": "~1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.25.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@tailwindcss/webpack": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-turbo": "^2.10.5",
    "eslint-plugin-oxlint": "^1.73.0",
    "oxlint": "^1.74.0",
    "shadcn": "^4.13.1",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
