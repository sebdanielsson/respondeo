{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:only": "bun --bun run build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "tsc": "bun --bun run types:check",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint && eslint",
    "stylelint": "stylelint --allow-empty-input \"./**/*.css\""
  },
  "dependencies": {
    "fumadocs-core": "16.7.10",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.7.10",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@fumadocs/cli": "^1.3.4",
    "@tailwindcss/webpack": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-oxlint": "^1.58.0",
    "oxlint": "^1.58.0",
    "stylelint": "^17.6.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2"
  }
}
