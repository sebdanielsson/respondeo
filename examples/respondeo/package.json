    "stylelint": "stylelint --allow-empty-input \"./**/*.css\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx ./lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests"
  },
