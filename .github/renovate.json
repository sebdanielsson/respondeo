{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "description": "config:recommended ignores **/examples/**, but examples/respondeo is the published create-respondeo-app template and must stay dependency-identical to apps/web (enforced by scripts/check-template-sync.sh). Default list minus the examples glob.",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "groupName": "all patch dependencies (manual)",
      "groupSlug": "all-patch-manual",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/"
    },
    {
      "description": "create-respondeo-app is never automerged (see the last rule), so keep its patches out of the automerged group.",
      "groupName": "all patch dependencies (manual)",
      "groupSlug": "all-patch-manual",
      "matchUpdateTypes": ["patch"],
      "matchFileNames": ["packages/create-respondeo-app/**"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": [
        "oxlint",
        "oxlint-**",
        "@oxlint/**",
        "oxfmt",
        "@oxfmt/**",
        "eslint-plugin-oxlint",
        "oxc-**",
        "@oxc-*/**"
      ]
    },
    {
      "groupName": "AI SDK",
      "matchPackageNames": ["ai", "@ai-sdk/**"]
    },
    {
      "groupName": "Fumadocs",
      "matchPackageNames": ["fumadocs-**", "@fumadocs/**"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "A fix(deps) commit touching create-respondeo-app triggers a Release Please release, so never automerge it. Positive glob on purpose: matchFileNames also tests the shared root pnpm-lock.yaml, so a negated glob would still match.",
      "matchFileNames": ["packages/create-respondeo-app/**"],
      "automerge": false
    }
  ]
}
