{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "description": "config:recommended ignores **/examples/**, but examples/respondeo is the published create-respondeo-app template and must stay dependency-identical to apps/web (enforced by scripts/check-template-sync.sh). Default list minus the examples glob.",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "oxc",
      "matchPackageNames": [
        "oxlint",
        "oxlint-**",
        "@oxlint/**",
        "oxfmt",
        "@oxfmt/**",
        "eslint-plugin-oxlint",
        "oxc-**",
        "@oxc-*/**"
      ]
    },
    {
      "groupName": "AI SDK",
      "matchPackageNames": ["ai", "@ai-sdk/**"]
    },
    {
      "groupName": "Fumadocs",
      "matchPackageNames": ["fumadocs-**", "@fumadocs/**"]
    }
  ]
}
